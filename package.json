{
  "name": "medium-enhancer",
  "displayName": "Medium Enhancer",
  "version": "0.8.3",
  "description": "AI summaries with Ollama or your own OpenAI/Anthropic key, Markdown and Obsidian export, and RSS feeds for Medium articles.",
  "author": "Wesley Wei",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*.medium.com/*",
      "https://*.itnext.io/*",
      "https://*.uxdesign.cc/*",
      "https://*.gopubby.com/*",
      "https://*.towardsai.net/*",
      "https://*.bettermarketing.pub/*",
      "https://*.writingcooperative.com/*",
      "https://api.openai.com/*",
      "https://api.anthropic.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ],
    "commands": {
      "summarize": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "Summarize current page with AI"
      }
    },
    "permissions": [
      "storage",
      "contextMenus",
      "scripting",
      "declarativeNetRequest",
      "activeTab",
      "clipboardWrite",
      "downloads"
    ],
    "author": "cwei3790@gmail.com",
    "optional_host_permissions": [
      "https://*/*",
      "http://*/*"
    ]
  }
}

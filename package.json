{
  "name": "medium-enhancer",
  "displayName": "Medium Enhancer",
  "version": "0.4.0",
  "description": "AI summaries (local Ollama or your own OpenAI/Anthropic key), one-click Markdown/Obsidian export, and RSS discovery for any long-form article.",
  "author": "Wesley Wei",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ],
    "commands": {
      "summarize": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "Summarize current page with AI"
      }
    },
    "permissions": [
      "storage",
      "contextMenus",
      "scripting",
      "declarativeNetRequest",
      "activeTab",
      "clipboardWrite"
    ],
    "author": "cwei3790@gmail.com"
  }
}
